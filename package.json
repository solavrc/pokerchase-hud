{
  "name": "pokerchase-hud",
  "version": "5.6.0",
  "scripts": {
    "build": "tsx scripts/build-extension.ts",
    "pack:crx": "bash scripts/pack-crx.sh",
    "mockup": "tsx scripts/build-mockup.ts --serve",
    "mockup:build": "tsx scripts/build-mockup.ts",
    "postbuild": "zip -r extension.zip dist/ icons/ manifest.json",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "validate-schema": "tsx src/tools/validate-schemas.ts",
    "schema-diff": "tsx src/tools/detect-schema-diff.ts",
    "verify-stats": "tsx src/tools/verify-stats.ts",
    "ccusage": "npx ccusage@latest",
    "build:e2e": "tsx e2e/tools/build-e2e.ts",
    "e2e:smoke": "tsx e2e/scenarios/smoke.ts",
    "e2e:auth-storage": "tsx e2e/scenarios/auth-storage-access.ts",
    "e2e:playerid": "tsx e2e/scenarios/playerid-session-persistence.ts",
    "e2e:mv3-lifecycle": "tsx e2e/scenarios/mv3-service-worker-lifecycle.ts",
    "e2e:browser-gate": "npm run e2e:smoke && npm run e2e:auth-storage && npm run e2e:mv3-lifecycle",
    "e2e": "tsx e2e/run.ts",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "firebase:deploy:indexes": "firebase deploy --only firestore:indexes",
    "firebase:emulators": "firebase emulators:start --only firestore"
  },
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@puppeteer/browsers": "^3.0.6",
    "@sentry/esbuild-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.2.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-jest": "^30.4.1",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "puppeteer-core": "^25.4.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "ws": "^8.21.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@msgpack/msgpack": "^3.1.3",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@sentry/browser": "^10.69.0",
    "dexie": "^4.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.0",
    "zod": "^4.4.3"
  }
}
